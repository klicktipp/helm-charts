{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:best-practices"],
  "semanticCommits": "enabled",
  "ignorePresets": ["docker:pinDigests", ":pinDevDependencies"],
  "gitIgnoredAuthors": [
    "/^[0-9]+\\+klicktipp-helm-docs-bot\\[bot\\]@users\\.noreply\\.github\\.com$/"
  ],
  "packageRules": [
    {
      "description": "Automerge non-major updates when CI is green. A merge only publishes a new chart version. k8stipp pins exact chart versions, so the renovate-bench rollout in k8stipp stays the gate for the clusters.",
      "matchUpdateTypes": ["minor", "patch", "pin", "pinDigest", "digest"],
      "automerge": true
    },
    {
      "description": "RabbitMQ keeps data: a person merges these updates.",
      "matchFileNames": ["charts/rabbitmq-*/**"],
      "automerge": false
    },
    {
      "description": "Automerge minor, patch, pin, and digest updates for openai-tunnel-client",
      "matchPackageNames": ["ghcr.io/klicktipp/openai-tunnel-client"],
      "matchUpdateTypes": ["minor", "patch", "pin", "pinDigest", "digest"],
      "automerge": true
    },
    {
      "description": "Automerge patch updates for rspamd",
      "matchPackageNames": ["rspamd/rspamd"],
      "matchUpdateTypes": ["patch"],
      "automerge": true
    },
    {
      "description": "Automerge patch updates for powerdns-recursor (security fixes)",
      "matchPackageNames": ["powerdns/pdns-recursor-54"],
      "automerge": true,
      "matchUpdateTypes": ["patch"]
    },
    {
      "changelogUrl": "https://github.com/n8n-io/n8n",
      "matchPackageNames": ["n8nio/n8n", "n8n"]
    },
    {
      "description": "n8n betas have plain version numbers (no -beta suffix), so Docker tags cannot tell them apart. Read the versions from GitHub releases instead, where betas are marked as pre-release and Renovate skips them.",
      "matchDatasources": ["docker"],
      "matchPackageNames": ["n8nio/n8n"],
      "overrideDatasource": "github-releases",
      "overridePackageName": "n8n-io/n8n",
      "extractVersion": "^n8n@(?<version>\\d+\\.\\d+\\.\\d+)$"
    },
    {
      "description": "One branch per chart: bumpVersions bumps only one chart per branch, and the chart-testing lint needs a bump in every changed chart.",
      "matchFileNames": ["charts/**"],
      "additionalBranchPrefix": "{{parentDir}}-",
      "commitMessageSuffix": "({{parentDir}})",
      "bumpVersions": [
        {
          "filePatterns": ["{{packageFileDir}}/Chart.{yaml,yml}"],
          "matchStrings": ["version:\\s(?<version>[^\\s]+)"],
          "bumpType": "{{#if isPatch}}patch{{else}}minor{{/if}}"
        }
      ]
    }
  ],
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": ["/(^|/)Chart\\.ya?ml$/"],
      "matchStrings": [
        "#\\s*renovate:\\s*datasource=(?<datasource>\\S+)\\s*depName=(?<depName>\\S+)(?:\\s*versioning=(?<versioning>\\S+))?[\\s\\S]*?appVersion\\s*:\\s*\"?(?<currentValue>[^\"\\n\\r]*)\"?"
      ],
      "versioningTemplate": "{{#if versioning}}{{{versioning}}}{{else}}semver{{/if}}"
    }
  ]
}
